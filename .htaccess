<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /website_873610e6/
    
    # ALLOW: All existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # ALLOW: API endpoints - route all /api/* requests to api/index.php
    RewriteRule ^api/(.*)$ api/index.php?route=$1 [L,QSA]
</IfModule>

# Disable directory listing
Options -Indexes

# Default charset
AddDefaultCharset UTF-8
